// nb@2026.05.30
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "left": 2,
      "right": 2,
      "top": 2
    }
  },
  "display": {
    "separator": ""
  },
  "modules": [
    {
      "color": {
        "user": "black",
        "at": "black",
        "host": "black"
      },
      "type": "title",
      "format": "┌───────────────\u001B[30;47m {6}\u001B[0m\u001B[30;47m{7}\u001B[0m\u001B[30;47m{8}\u001B[0m\u001B[30;47m \u001B[0m───────────────┐"
    },
    "break",
    {
      "key": "   OS         ",
      "keyColor": "green",
      "type": "os"
    },
    {
      "key": "   Host       ",
      "keyColor": "green",
      "type": "host"
    },
    {
      "key": "   Kernel     ",
      "keyColor": "yellow",
      "type": "kernel"
    },
    {
      "key": "   Shell      ",
      "keyColor": "red",
      "type": "shell"
    },
    {
      "key": "   Terminal   ",
      "keyColor": "magenta",
      "type": "terminal"
    },
    {
      "key": "   CPU Usage  ",
      "keyColor": "magenta",
      "type": "cpuusage"
    },
    {
      "key": "   Memory     ",
      "keyColor": "blue",
      "type": "memory"
    },
    "break",
    {
      "type": "custom",
      "format": "└──────────── \u001B[31m⬤  \u001B[32m⬤  \u001B[33m⬤  \u001B[34m⬤  \u001B[35m⬤  \u001B[36m⬤  \u001B[37m⬤  ───────────┘"
    }
  ]
}