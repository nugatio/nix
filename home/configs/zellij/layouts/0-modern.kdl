// nb@2025.05.28

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {

                // LEFT: Green (OS) -> Yellow (Session) -> Bright Red (Mode)
                format_left   "#[bg=green,fg=black] {command_host_os_icon} #[bg=yellow,fg=black,bold] {session} #[bg=bright_red,fg=bright_white,bold]{mode}"

                // CENTER: Bright Blue Background (Space) -> Tabs
                format_center "{tabs}"
                format_space  "#[bg=bright_blue]"

                // RIGHT: Bright Blue (Swap) -> Bright Magenta (Time)
                format_right  "#[bg=bright_blue,fg=bright_white,bold] {swap_layout} #[bg=bright_magenta,fg=bright_white,bold] {datetime} "

                // MODES: All set to red
                mode_normal        "#[bg=bright_red,fg=bright_white,bold] NORMAL "
                mode_locked        "#[bg=bright_red,fg=bright_white,bold] LOCKED "
                mode_resize        "#[bg=bright_red,fg=bright_white,bold] RESIZE "
                mode_pane          "#[bg=bright_red,fg=bright_white,bold] PANE "
                mode_tab           "#[bg=bright_red,fg=bright_white,bold] TAB "
                mode_scroll        "#[bg=bright_red,fg=bright_white,bold] SCROLL "
                mode_enter_search  "#[bg=bright_red,fg=bright_white,bold] ENTER_SEARCH "
                mode_search        "#[bg=bright_red,fg=bright_white,bold] SEARCH "
                mode_rename_tab    "#[bg=bright_red,fg=bright_white,bold] RENAME_TAB "
                mode_rename_pane   "#[bg=bright_red,fg=bright_white,bold] RENAME_PANE "
                mode_session       "#[bg=bright_red,fg=bright_white,bold] SESSION "
                mode_move          "#[bg=bright_red,fg=bright_white,bold] MOVE "
                mode_prompt        "#[bg=bright_red,fg=bright_white,bold] PROMPT "
                mode_tmux          "#[bg=bright_red,fg=bright_white,bold] TMUX "

                // TABS: Number only ({index}) + Extra Padding
                tab_normal "#[bg=bright_blue,fg=bright_white,bold]  {index}  {sync_indicator}{fullscreen_indicator}{floating_indicator}"
                tab_active "#[bg=black,fg=bright_white,bold]  {index}  {sync_indicator}{fullscreen_indicator}{floating_indicator}"

                // Indicators
                tab_sync_indicator       "󰓦 "
                tab_fullscreen_indicator "󱟱 "
                tab_floating_indicator   "󰉈 "

                // COMMANDS & DATA
                command_host_os_icon_command "sh -c \"echo $(uname -s | grep -qi 'darwin' && echo '󰀵')$(uname -s | grep -qi 'linux' && echo '')$(uname -s | grep -qi 'nt' && echo '󰖳')\""
                command_host_os_icon_format "{stdout}"
                command_host_os_icon_interval "0"
                command_host_os_icon_rendermode "static"

                datetime          "{format}"
                datetime_format   "%d-%m-%Y %H:%M"
                datetime_timezone "Europe/Berlin"
            }
        }

        children
    }
}
