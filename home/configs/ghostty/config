# Background & Foreground
background            = #232136
foreground            = #e0def4
selection-background  = #44415a
selection-foreground  = #e0def4
cursor-color          = #56526e

# Standard Colors (0–7)
palette = 0=#2a273f
palette = 1=#eb6f92
palette = 2=#3e8fb0
palette = 3=#f6c177
palette = 4=#9ccfd8
palette = 5=#c4a7e7
palette = 6=#ea9a97
palette = 7=#e0def4

# Bright Colors (8–15)
palette = 8=#6e6a86
palette = 9=#eb6f92
palette = 10=#3e8fb0
palette = 11=#f6c177
palette = 12=#9ccfd8
palette = 13=#c4a7e7
palette = 14=#ea9a97
palette = 15=#e0def4


# ////////// SHADER //////////

custom-shader-animation = true
custom-shader           = shaders/cursor_sweep.glsl
custom-shader           = shaders/ripple_rectangle_cursor.glsl


# ////////// KEY COMBOS //////////

keybind = option+backspace=text:\x1b\x7f
