# nb@2025.05.28

# ////////// CORE TERMINAL APPEARANCE //////////

macos-titlebar-style = hidden

window-colorspace = display-p3

macos-auto-secure-input       = true
macos-secure-input-indication = true

keybind = cmd+alt+i=unbind
keybind = cmd+alt+w=unbind
keybind = cmd+alt+h=unbind
keybind = cmd+alt+q=unbind
keybind = cmd+alt+m=unbind
keybind = cmd+q=unbind
keybind = alt+q=unbind
keybind = cmd+m=unbind
keybind = alt+m=unbind


# ////////// FONT & TEXT RENDERING //////////

font-family           = "PragmataPro Mono Liga"
font-size             = 13
font-thicken          = true
font-thicken-strength = 127
bold-is-bright        = true
adjust-cell-width     = 0%
adjust-cell-height    = 0%
font-feature          = calt
font-feature          = liga
font-feature          = dlig


# ////////// CURSOR & MOUSE //////////

cursor-style        = block
cursor-style-blink  = true
cursor-invert-fg-bg = true

mouse-hide-while-typing = true

copy-on-select = clipboard


# ///////// WINDOW LAYOUT & PADDING //////////

window-padding-x = 0
window-padding-y = 0

window-padding-balance = true


# ////////// SHELL INTEGRATION //////////

shell-integration          = detect
shell-integration-features = no-cursor


# ////////// COLOR PALETTE //////////

minimum-contrast = 1.1

